{
  "name": "@brainpost/obsidian-plugin",
  "version": "0.1.1",
  "private": true,
  "description": "BrainPost plugin for automatic note sync into Obsidian",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --external:obsidian --external:node:* --format=cjs --platform=browser --outfile=main.js",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
